{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure BeebAsm",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build BeebAsm",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug"
      ],
      "dependsOn": "Configure BeebAsm",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean BeebAsm",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug",
        "--target",
        "clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "Test BeebAsm",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/build",
        "--output-on-failure"
      ],
      "dependsOn": "Build BeebAsm",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install BeebASM (User)",
      "type": "shell",
      "command": "mkdir -p ~/.local/bin && cp ${workspaceFolder}/build/beebasm ~/.local/bin/beebasm && chmod +x ~/.local/bin/beebasm",
      "windows": {
        "command": "echo This task is only supported on Linux && exit 1"
      },
      "linux": {
        "command": "mkdir -p ~/.local/bin && cp ${workspaceFolder}/build/beebasm ~/.local/bin/beebasm && chmod +x ~/.local/bin/beebasm"
      },
      "osx": {
        "command": "echo This task is only supported on Linux && exit 1"
      },
      "dependsOn": "Build BeebAsm",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
