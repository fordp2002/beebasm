{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug BeebAsm (demo)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/beebasm",
      "args": [
        "-i",
        "${workspaceFolder}/demo.6502",
        "-do",
        "${workspaceFolder}/build/demo.ssd",
        "-boot",
        "Code",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "preLaunchTask": "Build BeebAsm"
    }
  ]
}
